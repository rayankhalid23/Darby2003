{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "tunnel": "lt --port 8000 --subdomain darby-app-api",
        "backend": "concurrently \"php artisan serve\" \"npm run tunnel\" \"php artisan queue:work\" \"powershell -ExecutionPolicy Bypass -File scripts/start-ai.ps1\""
    },
    "devDependencies": {
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.0.0",
        "vite": "^5.0.0"
    },
    "dependencies": {
        "localtunnel": "^2.0.2"
    }
}