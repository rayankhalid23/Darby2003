    {
      "name": "2) حالات الخطأ (كل رسائل التحقق)",
      "description": "كل طلب هنا يجب أن يفشل — للتأكد من وجود الرسالة الصحيحة وكود الخطأ الصحيح.",
      "item": [
        {
          "name": "2.1 إضافة بلا حقول (كل رسائل الإجباري)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/parent/addresses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "parent",
                "addresses"
              ]
            },
            "description": "المتوقع 422 مع errors لكل من: label, lat, lng, zone_id\n\nالرسائل:\n- مسمى العنوان مطلوب.\n- إحداثيات خط العرض مطلوبة.\n- إحداثيات خط الطول مطلوبة.\n- يرجى تحديد المنطقة الجغرافية التابع لها العنوان.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{parent_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "const j = pm.response.json();",
